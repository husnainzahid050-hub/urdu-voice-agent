# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM: Gemini free tier --------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m scripts.list_gemini_models` to see what your key can use. Flash-Lite is the
# fastest (~1.2 s) with good Urdu.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.6
# Thinking tokens count against this limit too.
GEMINI_MAX_OUTPUT_TOKENS=400
# "Thinking" adds seconds of latency. Gemini 3+ models: MINIMAL | LOW | MEDIUM | HIGH.
# Gemini 2.5 models use GEMINI_THINKING_BUDGET instead (0 = off) and reject the level.
# Leave both empty to use the model's default.
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_THINKING_BUDGET=
# The free tier allows only ~20 requests per day per model. When GEMINI_MODEL's daily
# quota is used up, these are tried in order (comma-separated; each has its own quota
# and must accept GEMINI_THINKING_LEVEL).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# --- Speech-to-text ----------------------------------------------------------
# gemini  = Gemini audio transcription: fast (~1.5-3 s) and most accurate; online
# whisper = local faster-whisper: offline but slow on a laptop CPU
STT_BACKEND=gemini
# Comma-separated: each model has its own daily free quota (gemini-3.5-transcribe: 25/day).
GEMINI_STT_MODEL=gemini-3.5-transcribe,gemini-3.1-flash-lite
# With STT_BACKEND=gemini: switch to local Whisper when Gemini is unreachable
# (whisper) or fail instead (none).
STT_FALLBACK=whisper
# Local Whisper: tiny | base | small | medium | large-v3, a CTranslate2 repo id,
# or a local folder.
STT_MODEL=small
# auto = cuda + float16 with an NVIDIA GPU, else cpu + int8
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=ur
STT_BEAM_SIZE=5
# 0 = let CTranslate2 decide
STT_CPU_THREADS=0

# --- Text-to-speech ----------------------------------------------------------
# edge = Microsoft neural Urdu voice (free, natural, needs internet; falls back to mms)
# mms  = Meta MMS voice, fully offline but robotic
TTS_BACKEND=edge
TTS_MODEL=facebook/mms-tts-urd-script_arabic
# ur-PK-UzmaNeural (female) | ur-PK-AsadNeural (male)
TTS_VOICE=ur-PK-UzmaNeural
# Speed, e.g. -10% slower, +10% faster
TTS_RATE=+0%

# --- Agent persona -----------------------------------------------------------
# female | male  (Urdu verbs change with gender; match it to TTS_VOICE)
AGENT_GENDER=female

# --- Audio / logging ---------------------------------------------------------
SAMPLE_RATE=16000
RECORD_SECONDS=5
# Conversation: stop listening after this much silence, and give up waiting after
# START_TIMEOUT_SECONDS without speech (it then listens again).
END_SILENCE_MS=900
MAX_TURN_SECONDS=20
START_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# --- Deployment (public link) -------------------------------------------------
# local = laptop with all models (default). cloud = public server: online models only,
# no torch/Whisper/MMS, per-visitor chats, rate limits, nothing written to disk.
# See docs/DEPLOY.md. In cloud mode the defaults below already apply.
APP_MODE=local
# Behind a reverse proxy (Render): read the visitor IP from X-Forwarded-For.
TRUST_PROXY=0
# Turns (spoken or typed messages) allowed. 0 = no limit. Cloud defaults: 8 / 30 / 100.
# Google's free tier (~20-25 requests/day per model) is the real ceiling of a public demo;
# a paid key raises it.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_DAY=
DAILY_TURN_LIMIT=
# Only if the page is hosted on another domain (comma-separated origins).
ALLOWED_ORIGINS=
# Cloud defaults: SERVER_VAD=0 TTS_FALLBACK=none LATENCY_LOG=0 LOG_TRANSCRIPTS=0
SERVER_VAD=
TTS_FALLBACK=
LATENCY_LOG=
LOG_TRANSCRIPTS=
