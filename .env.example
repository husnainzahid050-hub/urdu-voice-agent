# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM: Gemini free tier --------------------------------------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m scripts.list_gemini_models` and paste a suggested Flash / Flash-Lite name.
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.6
# Thinking tokens count against this limit too.
GEMINI_MAX_OUTPUT_TOKENS=400
# "Thinking" adds seconds of latency. Gemini 3+ models: MINIMAL | LOW | MEDIUM | HIGH.
# Gemini 2.5 models use GEMINI_THINKING_BUDGET instead (0 = off) and reject the level.
# Leave both empty to use the model's default.
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_THINKING_BUDGET=

# --- Speech-to-text: faster-whisper ------------------------------------------
# tiny | base | small | medium | large-v3, a CTranslate2 repo id, or a local folder.
STT_MODEL=medium
# auto = cuda + float16 with an NVIDIA GPU, else cpu + int8
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=ur
STT_BEAM_SIZE=5

# --- Text-to-speech ----------------------------------------------------------
TTS_BACKEND=mms
TTS_MODEL=facebook/mms-tts-urd-script_arabic

# --- Audio / logging ---------------------------------------------------------
SAMPLE_RATE=16000
RECORD_SECONDS=5
LOG_LEVEL=INFO
